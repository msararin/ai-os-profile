# Auth.js / NextAuth local configuration
# Auth.js v5 accepts AUTH_* and keeps NEXTAUTH_* compatibility aliases.
AUTH_SECRET="generate-a-local-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Compatibility aliases only if a future implementation standardizes on legacy names.
# NEXTAUTH_SECRET="generate-a-local-secret-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Immutable subject from a verified Google ID token. Missing binding denies all access.
OWNER_GOOGLE_SUB=""

# Optional telemetry ledger path for internal dashboard data.
# In production, configure a production-readable path/export. Do not use a local Mac path.
# TELEMETRY_LEDGER_DB_PATH="/path/to/production-readable/aios_observability.sqlite"
# DATABASE_PATH="/path/to/production-readable/public-observability.sqlite"

# Local callback URL to add in Google Console when local browser testing is authorized:
# http://localhost:3000/api/auth/callback/google

# Private store populated outside public Git; missing store fails closed.
# COCKPIT_PRIVATE_STORE_PATH="/private/owner-evidence"
# Sanitized operational snapshot conforming to lib/cockpit/operations.ts. Optional.
# COCKPIT_OPERATIONS_PATH="/private/sanitized-operations.json"

# Hosted archive: existing private Vercel Blob, authenticated SDK reads only.
# COCKPIT_PRIVATE_ARCHIVE="owner-cockpit/<sha256>.json"
# COCKPIT_PRIVATE_ARCHIVE_SHA256="<sha256>"
# BLOB_STORE_ID is provided by the existing store connection.
